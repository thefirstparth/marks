{
 "$comment": "Everything the library holds, in plain words. `node scripts/build.mjs` fetches it; `node scripts/names.mjs` refreshes config/people.json from what people bet on. Edit freely.",
 "limits": {
  "$comment": "Where gathering stops, so the library stays small and useful. Clubs: the leagues below, at most 900 crests. Faces: at most 300 (key people first: hand entries, then the seed list); everyone else shows the flag they play under. People: at most 1,200 names, most traded first. The whole library: at most 40 MB. A daily run adds at most 30 new marks and rechecks at most 30 due ones. Rechecks: crests every 180 days (rebrands), tournament and team logos yearly, faces yearly (a newer photo), people without a face every 180 days.",
  "clubs": 900,
  "faces": 300,
  "people": 1200,
  "total_mb": 40,
  "daily_new": 30,
  "daily_recheck": 30,
  "recheck_days": {
   "clubs": 180,
   "own": 365,
   "faces": 365,
   "no_face": 180
  }
 },
